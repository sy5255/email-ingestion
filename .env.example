MYSQL_HOST=10.172.127.210
MYSQL_PORT=3306
MYSQL_DATABASE=fspas
MYSQL_USER=dbuser
MYSQL_PASSWORD=change-me

POP3_HOST=pop3.example.com
POP3_PORT=995
POP3_USER=change-me
POP3_PASSWORD=change-me
POP3_USE_SSL=true
POP3_TIMEOUT_SECONDS=30
MAILBOX_KEY=default

# 기본 실행: 55분 처리 + 3분 유휴, 총 58분 후 종료
RUN_ONCE=false
POLL_SECONDS=60
INGESTION_ACTIVE_WINDOW_SECONDS=3300
INGESTION_REST_WINDOW_SECONDS=180

# 단발성 점검이 필요할 때만 true로 변경
# RUN_ONCE=true

# REALTIME: 수집 실행에서 바로 저장
# NIGHT: 수집 시 DB에만 적재하고 --archive-only 실행에서 저장
# DISABLED: DB 라우팅만 하고 파일을 저장하지 않음
FILE_ARCHIVE_MODE=NIGHT
# NIGHT 모드 자동 저장 시간대(서버 시각, 시작 포함 ~ 끝 미포함). 같게 두면 자동 저장 끔
FILE_ARCHIVE_AUTO_START_HOUR=4
FILE_ARCHIVE_AUTO_END_HOUR=5
FILE_ARCHIVE_BATCH_SIZE=100
FILE_ARCHIVE_SOURCE_MISSING_GRACE_MINUTES=10
MAIL_ARCHIVE_SAVE_ROOT=/config/work/sharedworkspace/mail_archive

MAX_RETRY_COUNT=3
STALE_PROCESSING_MINUTES=15
INGESTION_LOCK_NAME=email_ingestion_pop3
INGESTION_LOCK_WAIT_SECONDS=0

# S3 저장 (ingest_pop3.py가 파일을 저장하는 회차마다 함께 실행, README "S3 저장")
S3_STORE_ENABLED=false
S3_ENDPOINT_URL=http://s3.dataplatform.samsungds.net:9020
S3_REGION=KOR-HS
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=Analysis_Report
S3_ADDRESSING_STYLE=path
# 부서별 접두어. {site} 자리에 규칙 action의 site(없으면 STORE_DEFAULT_SITE)
S3_SITE_PREFIX_TEMPLATE={site}/sharedworkspace
STORE_DEFAULT_SITE=IFA
# ingest_pop3.py 한 회차에서 업로드에 쓰는 최대 시간(초). 남은 것은 다음 회차에
STORE_BUDGET_PER_RUN_SEC=300
# python store_to_s3.py 단독 실행의 최대 시간(초)
STORE_TIME_BUDGET_SEC=3000
# 일시 오류 재시도 횟수. S3가 밤새 죽어 있어도 FAILED가 되기 전에 넉넉히
STORE_MAX_ATTEMPT=50
# 영구 실패가 아닌 FAILED를 이 시간이 지나면 다시 대기로 (다음 날 새벽 회차에서 재업로드)
STORE_REVIVE_HOURS=20
# 로컬 메일 사본: keep(기본) | after_parse(업로드+파싱 후 삭제, 권장) | after_store(업로드 후 삭제)
LOCAL_MAIL_RETENTION=keep
